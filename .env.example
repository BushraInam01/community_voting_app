# Copy to .env and fill in. Never commit .env.

# Required. Generate one with:
#   python3 -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# True only for local development.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Time zone used for poll expiry times entered in the create-poll form.
TIME_ZONE=UTC

# --- Optional -------------------------------------------------------------

# Sites allowed to iframe /polls/embed/<slug>/ (space separated; default: any).
# EMBED_FRAME_ANCESTORS=https://example.com https://blog.example.org

# Anonymous-vote limit per poll, per network address, per window.
# ANONYMOUS_VOTES_PER_IP=10
# ANONYMOUS_VOTE_WINDOW_SECONDS=86400

# Failed logins (per IP + username) before a temporary lockout.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
# LOGIN_MAX_FAILURES_PER_IP=50
# LOGIN_MAX_FAILURES_PER_USERNAME=30
# LOGIN_FAILURE_WINDOW_SECONDS=3600

# Production HTTPS settings (defaults shown are for DEBUG=False).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Production email (only used when DEBUG=False; the app sends no email yet).
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
